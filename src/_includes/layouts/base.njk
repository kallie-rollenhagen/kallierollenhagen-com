<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ seoDescription or site.description }}">
  <title>{{ title }} | Kallie Rollenhagen</title>
  <link rel="stylesheet" href="{{ '/assets/css/styles.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/custom.css' | url }}">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='16' fill='%23DEEE81'/%3E%3C/svg%3E">
  <script src="{{ '/assets/js/main.js' | url }}" defer></script>
  {% if site.analyticsId %}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analyticsId }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', '{{ site.analyticsId }}');
    </script>
  {% endif %}
</head>
<body class="{% if title == 'Kallie Rollenhagen' %}home-layout{% endif %}">
  {% include "partials/header.njk" %}
  <div id="grid-container" class="grid-inherit">
    <main class="grid-inherit">
      {{ content | safe }}
    </main>
  </div>
  {% if scripts %}
    {% for scriptPath in scripts %}
      <script src="{{ scriptPath | url }}"></script>
    {% endfor %}
  {% endif %}
  <button id="backToTop" aria-label="Back to top">
    <svg xmlns="http://www.w3.org/2000/svg"
       width="30"
       height="30"
       viewBox="0 0 60 60">
    <path d="M0 20 h60 L30 55 v-11 L44 27 H0z"
          fill="currentColor" />
  </svg>
  </button>
</body>
</html>